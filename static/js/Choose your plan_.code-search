# Query: Choose your plan.
# ContextLines: 1

{% extends "base.html" %}
{% load static %}

{% block title %}Iron Fitness | Train Strong{% endblock %}

{% block content %}

<link rel="stylesheet" href="{% static 'css/style.css' %}">

<section class="hero">
  <div class="container hero-content">

    <div class="eyebrow">STRONGER EVERY DAY</div>

    <h1>Build your <span>strongest</span> self.</h1>

    <p>
      Modern training, expert guidance and a community that keeps you moving.
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href="{% url 'membership' %}">
        Explore Membership
      </a>

      <a class="btn btn-ghost" href="{% url 'classes' %}">
        View Classes
      </a>
    </div>

    <div class="hero-stats">

      <div>
        <b class="stat-number" data-target="10" data-suffix="+">0+</b>
        <small>Years of training</small>
      </div>

      <div>
        <b class="stat-number" data-target="25" data-suffix="+">0+</b>
        <small>Weekly sessions</small>
      </div>

      <div>
        <b class="stat-number" data-target="100" data-suffix="%">0%</b>
        <small>Member focused</small>
      </div>

    </div>

  </div>
</section>


<section class="section">

  <div class="container section-head">

    <div>
      <span class="eyebrow">WHY IRON FITNESS</span>
      <h2>Train with purpose.</h2>
    </div>

    <a class="text-link" href="{% url 'about' %}">
      About us →
    </a>

  </div>

  <div class="feature-grid">

    <article class="feature">
      <div class="icon">01</div>
      <h3>Expert Coaching</h3>
      <p>
        Structured guidance for strength, mobility and conditioning.
      </p>
    </article>

    <article class="feature">
      <div class="icon">02</div>
      <h3>Modern Equipment</h3>
      <p>
        Everything you need for focused, effective workouts.
      </p>
    </article>

    <article class="feature">
      <div class="icon">03</div>
      <h3>Real Community</h3>
      <p>
        A supportive gym environment built around consistency.
      </p>
    </article>

  </div>

</section>


<section class="section dark-section">

  <div class="container">

    <div class="section-head">

      <div>
        <span class="eyebrow">MEMBERSHIPS</span>
        <h2>Choose your plan.</h2>
      </div>

      <a class="text-link" href="{% url 'membership' %}">
        All plans →
      </a>

    </div>


    <div class="card-grid">

      {% for plan in plans %}

      <article class="plan-card {% if plan.is_popular %}popular{% endif %}">

        {% if plan.is_popular %}
        <span class="tag">POPULAR</span>
        {% endif %}

        <h3>{{ plan.name }}</h3>

        <div class="price">
          ₹{{ plan.price|floatformat:0 }}
          <small>/{{ plan.duration_days }} days</small>
        </div>

        <p>{{ plan.description }}</p>

        <details class="plan-features">
          <summary>View Features</summary>

          <ul>
            {% for f in plan.feature_list %}
            <li>✓ {{ f }}</li>
            {% endfor %}
          </ul>

        </details>

        <a class="btn btn-primary full" href="{% url 'join_plan' plan.slug %}">
          Choose Plan
        </a>

      </article>

      {% empty %}

      <p>
        No plans yet. Run
        <code>python manage.py seed_demo_data</code>.
      </p>

      {% endfor %}

    </div>

  </div>

</section>


<section class="cta">

  <div class="container cta-inner">

    <div>
      <span class="eyebrow">READY?</span>
      <h2>Your next workout starts here.</h2>
    </div>

    <a class="btn btn-primary" href="{% url 'register' %}">
      Create Account
    </a>

  </div>

</section>


<script src="{% static 'js/counter.js' %}"></script>

{% endblock %}